@model Endereco

@{
    ViewData["Title"] = "Detalhes do endereço";
}

<h1 class="h3 mb-3">Detalhes do endereço</h1>

<div class="card mb-3">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">CEP</dt>
            <dd class="col-sm-9">@Model.Cep</dd>

            <dt class="col-sm-3">Logradouro</dt>
            <dd class="col-sm-9">@Model.Logradouro</dd>

            <dt class="col-sm-3">Número</dt>
            <dd class="col-sm-9">@Model.Numero</dd>

            <dt class="col-sm-3">Complemento</dt>
            <dd class="col-sm-9">@(Model.Complemento ?? "-")</dd>

            <dt class="col-sm-3">Bairro</dt>
            <dd class="col-sm-9">@Model.Bairro</dd>

            <dt class="col-sm-3">Cidade/UF</dt>
            <dd class="col-sm-9">@Model.Cidade/@Model.Uf</dd>
        </dl>
    </div>
</div>

<div class="d-flex gap-2">
    <a href="/Enderecos/Edit/@Model.Id" class="btn btn-primary">Editar</a>
    <a href="/Enderecos" class="btn btn-outline-secondary">Voltar</a>
</div>
