@model IEnumerable<Endereco>

@{
    ViewData["Title"] = "Endereços";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 mb-1">Endereços</h1>
        <p class="text-muted mb-0">Gerencie os endereços salvos na sua conta.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="ExportCsv" class="btn btn-outline-secondary">Exportar CSV</a>
        <a asp-action="Create" class="btn btn-primary">Novo endereço</a>
    </div>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success" role="alert">
        @successMessage
    </div>
}

@if (!Model.Any())
{
    <div class="alert alert-info" role="alert">
        Nenhum endereço cadastrado ainda.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>CEP</th>
                    <th>Logradouro</th>
                    <th>Número</th>
                    <th>Bairro</th>
                    <th>Cidade/UF</th>
                    <th class="text-end">Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var endereco in Model)
                {
                    <tr>
                        <td>@endereco.Cep</td>
                        <td>@endereco.Logradouro</td>
                        <td>@endereco.Numero</td>
                        <td>@endereco.Bairro</td>
                        <td>@endereco.Cidade/@endereco.Uf</td>
                        <td class="text-end">
                            <div class="btn-group" role="group" aria-label="Ações do endereço">
                                <a asp-action="Details" asp-route-id="@endereco.Id" class="btn btn-sm btn-outline-secondary">Detalhes</a>
                                <a asp-action="Edit" asp-route-id="@endereco.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                                <a asp-action="Delete" asp-route-id="@endereco.Id" class="btn btn-sm btn-outline-danger">Excluir</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
