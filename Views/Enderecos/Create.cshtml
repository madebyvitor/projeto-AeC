@model projetoAeC.ViewModels.Enderecos.EnderecoViewModel
@removeTagHelper Microsoft.AspNetCore.Mvc.TagHelpers.FormTagHelper, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Novo endereço";
    string? ErrorFor(string fieldName) => ViewData.ModelState[fieldName]?.Errors.FirstOrDefault()?.ErrorMessage;
    var modelOnlyErrors = ViewData.ModelState[string.Empty]?.Errors;
    var antiforgery = Microsoft.Extensions.DependencyInjection.ServiceProviderServiceExtensions
        .GetRequiredService<Microsoft.AspNetCore.Antiforgery.IAntiforgery>(Context.RequestServices);
    var antiforgeryToken = antiforgery.GetAndStoreTokens(Context).RequestToken;
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <h1 class="h3 mb-3">Novo endereço</h1>

        <form action="/Enderecos/Create" method="post" novalidate>
            <input name="__RequestVerificationToken" type="hidden" value="@antiforgeryToken" />

            @if (modelOnlyErrors?.Count > 0)
            {
                <div class="text-danger mb-3 validation-summary-errors" data-valmsg-summary="true">
                    <ul>
                        @foreach (var error in modelOnlyErrors)
                        {
                            <li>@error.ErrorMessage</li>
                        }
                    </ul>
                </div>
            }

            <input id="Id" name="Id" type="hidden" value="@Model.Id" />

            <div class="row">
                <div class="col-md-4 mb-3">
                    <label for="Cep" class="form-label">CEP</label>
                    <input id="Cep" name="Cep" value="@Model.Cep" class="form-control" autocomplete="postal-code" data-cep-input maxlength="9"
                           data-val="true" data-val-required="Informe o CEP." data-val-length="O CEP deve ter no máximo 9 caracteres."
                           data-val-length-max="9" data-val-regex="Informe um CEP válido." data-val-regex-pattern="^\d{5}-?\d{3}$" />
                    <span class="text-danger field-validation-valid" data-valmsg-for="Cep" data-valmsg-replace="true">@ErrorFor("Cep")</span>
                    <div class="form-text" data-cep-feedback>Digite o CEP para buscar no ViaCEP.</div>
                </div>

                <div class="col-md-8 mb-3">
                    <label for="Logradouro" class="form-label">Logradouro</label>
                    <input id="Logradouro" name="Logradouro" value="@Model.Logradouro" class="form-control" data-viacep-field="logradouro"
                           data-val="true" data-val-required="Informe o logradouro." data-val-length="O logradouro deve ter no máximo 150 caracteres."
                           data-val-length-max="150" />
                    <span class="text-danger field-validation-valid" data-valmsg-for="Logradouro" data-valmsg-replace="true">@ErrorFor("Logradouro")</span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-3 mb-3">
                    <label for="Numero" class="form-label">Número</label>
                    <input id="Numero" name="Numero" value="@Model.Numero" class="form-control" autocomplete="address-line2"
                           data-val="true" data-val-required="Informe o número." data-val-length="O número deve ter no máximo 20 caracteres."
                           data-val-length-max="20" />
                    <span class="text-danger field-validation-valid" data-valmsg-for="Numero" data-valmsg-replace="true">@ErrorFor("Numero")</span>
                </div>

                <div class="col-md-9 mb-3">
                    <label for="Complemento" class="form-label">Complemento</label>
                    <input id="Complemento" name="Complemento" value="@Model.Complemento" class="form-control" autocomplete="address-line3"
                           data-val="true" data-val-length="O complemento deve ter no máximo 100 caracteres." data-val-length-max="100" />
                    <span class="text-danger field-validation-valid" data-valmsg-for="Complemento" data-valmsg-replace="true">@ErrorFor("Complemento")</span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-5 mb-3">
                    <label for="Bairro" class="form-label">Bairro</label>
                    <input id="Bairro" name="Bairro" value="@Model.Bairro" class="form-control" data-viacep-field="bairro"
                           data-val="true" data-val-required="Informe o bairro." data-val-length="O bairro deve ter no máximo 100 caracteres."
                           data-val-length-max="100" />
                    <span class="text-danger field-validation-valid" data-valmsg-for="Bairro" data-valmsg-replace="true">@ErrorFor("Bairro")</span>
                </div>

                <div class="col-md-5 mb-3">
                    <label for="Cidade" class="form-label">Cidade</label>
                    <input id="Cidade" name="Cidade" value="@Model.Cidade" class="form-control" data-viacep-field="localidade" autocomplete="address-level2"
                           data-val="true" data-val-required="Informe a cidade." data-val-length="A cidade deve ter no máximo 100 caracteres."
                           data-val-length-max="100" />
                    <span class="text-danger field-validation-valid" data-valmsg-for="Cidade" data-valmsg-replace="true">@ErrorFor("Cidade")</span>
                </div>

                <div class="col-md-2 mb-3">
                    <label for="Uf" class="form-label">UF</label>
                    <input id="Uf" name="Uf" value="@Model.Uf" class="form-control text-uppercase" data-viacep-field="uf" autocomplete="address-level1" maxlength="2"
                           data-val="true" data-val-required="Informe a UF." data-val-length="A UF deve ter 2 caracteres."
                           data-val-length-min="2" data-val-length-max="2" />
                    <span class="text-danger field-validation-valid" data-valmsg-for="Uf" data-valmsg-replace="true">@ErrorFor("Uf")</span>
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Salvar</button>
                <a href="/Enderecos" class="btn btn-outline-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
    <script src="/js/enderecos.js"></script>
}
