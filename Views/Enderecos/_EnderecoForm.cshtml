@model projetoAeC.ViewModels.Enderecos.EnderecoViewModel

<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
<input asp-for="Id" type="hidden" />

<div class="row">
    <div class="col-md-4 mb-3">
        <label asp-for="Cep" class="form-label"></label>
        <input asp-for="Cep" class="form-control" autocomplete="postal-code" data-cep-input maxlength="9" />
        <span asp-validation-for="Cep" class="text-danger"></span>
        <div class="form-text" data-cep-feedback>Digite o CEP para buscar no ViaCEP.</div>
    </div>

    <div class="col-md-8 mb-3">
        <label asp-for="Logradouro" class="form-label"></label>
        <input asp-for="Logradouro" class="form-control" data-viacep-field="logradouro" />
        <span asp-validation-for="Logradouro" class="text-danger"></span>
    </div>
</div>

<div class="row">
    <div class="col-md-3 mb-3">
        <label asp-for="Numero" class="form-label"></label>
        <input asp-for="Numero" class="form-control" autocomplete="address-line2" />
        <span asp-validation-for="Numero" class="text-danger"></span>
    </div>

    <div class="col-md-9 mb-3">
        <label asp-for="Complemento" class="form-label"></label>
        <input asp-for="Complemento" class="form-control" autocomplete="address-line3" />
        <span asp-validation-for="Complemento" class="text-danger"></span>
    </div>
</div>

<div class="row">
    <div class="col-md-5 mb-3">
        <label asp-for="Bairro" class="form-label"></label>
        <input asp-for="Bairro" class="form-control" data-viacep-field="bairro" />
        <span asp-validation-for="Bairro" class="text-danger"></span>
    </div>

    <div class="col-md-5 mb-3">
        <label asp-for="Cidade" class="form-label"></label>
        <input asp-for="Cidade" class="form-control" data-viacep-field="localidade" autocomplete="address-level2" />
        <span asp-validation-for="Cidade" class="text-danger"></span>
    </div>

    <div class="col-md-2 mb-3">
        <label asp-for="Uf" class="form-label"></label>
        <input asp-for="Uf" class="form-control text-uppercase" data-viacep-field="uf" autocomplete="address-level1" maxlength="2" />
        <span asp-validation-for="Uf" class="text-danger"></span>
    </div>
</div>
