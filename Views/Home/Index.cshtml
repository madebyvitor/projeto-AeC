@{
    ViewData["Title"] = "AddressHub";
}

<section class="home-hero">
    <div class="home-hero__content">
        <div class="brand-mark brand-mark--large" aria-hidden="true">
            <span class="brand-mark__pin"></span>
            <span class="brand-mark__road"></span>
        </div>

        <h1>Encontre, salve e exporte endereços com facilidade</h1>
        <p>
            Pesquise qualquer CEP, organize seus endereços e exporte quando precisar.
            Uma ferramenta minimalista para sua produtividade diária.
        </p>

        <div class="home-hero__actions">
            <a class="btn btn-home-primary" href="/Auth/Register">Começar agora</a>
            <a class="btn btn-home-secondary" href="/Auth/Login">Fazer login</a>
        </div>
    </div>
</section>

<section class="home-features" aria-label="Recursos principais">
    <article class="home-feature">
        <h2>Busca por CEP</h2>
        <p>Dados precisos e instantâneos para qualquer lugar do Brasil direto da base dos Correios.</p>
    </article>

    <article class="home-feature">
        <h2>Salve seus endereços</h2>
        <p>Organize sua lista pessoal para fácil acesso posterior.</p>
    </article>

    <article class="home-feature">
        <h2>Exporte seus dados</h2>
        <p>Leve suas informações para onde quiser no formato CSV.</p>
    </article>
</section>

<section class="home-final-cta">
    <div class="home-final-cta__card">
        <h2>Pronto para organizar seus endereços?</h2>
        <a class="btn btn-home-light" href="/Auth/Register">Crie sua conta</a>
    </div>
</section>
